<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon (API 26+).
     Both layers are produced from rafeeq_icon.png by scripts/generate_launcher_icons.sh,
     the same source used for the legacy mipmap-<density>/ic_launcher.png bitmaps.
     Note: an adaptive icon cannot reference "@mipmap/ic_launcher" (itself), so the
     foreground is the regenerated @drawable/ic_launcher_foreground layer. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
